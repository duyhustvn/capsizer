# ==============================================================================
# CẤU HÌNH HẠ TẦNG KẾT NỐI 3 MÁY (CAPSIZER INFRASTRUCTURE CONFIG)
# ==============================================================================
# File này CHỈ chứa thông tin hạ tầng kết nối cố định của môi trường test.
# Các thông số riêng của từng kịch bản (URL, steps, queries, users, body, profiler...)
# được quản lý độc lập tại: scenarios/<tên_kịch_bản>/scenario.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MACHINE 2: MÁY PHÁT TẢI (LOAD GENERATOR HOST QUA SSH)
# ------------------------------------------------------------------------------
# Lưu ý: Có thể điền tên Host alias đã khai báo trong ~/.ssh/config (kèm ProxyJump,
# IdentityFile, User, Port trong đó) và để trống REMOTE_USER / REMOTE_PORT / REMOTE_KEY.
LOADGEN_MODE="remote"                  # 'remote' (khuyên dùng) hoặc 'local'
REMOTE_HOST="192.168.1.50"             # IP, hostname hoặc Host alias trong ~/.ssh/config
REMOTE_USER="vbox"                     # SSH User (để trống "" nếu lấy từ ~/.ssh/config)
REMOTE_PORT="22"                       # Cổng SSH (để trống "" nếu lấy từ ~/.ssh/config)
REMOTE_KEY=""                          # SSH private key (để trống nếu dùng ~/.ssh/config hoặc key mặc định)
REMOTE_JUMP=""                         # Tùy chọn Jump Host (ProxyJump, ví dụ: user@bastion:22)
REMOTE_DIR="~/capsizer-loadtest"       # Thư mục làm việc trên máy phát tải

# ------------------------------------------------------------------------------
# 2. MACHINE 3: SERVER CỤM KUBERNETES TỪ XA (K8S MASTER / BASTION HOST QUA SSH)
# ------------------------------------------------------------------------------
# Skill sẽ SSH vào server này (hỗ trợ đi qua Jump Host / ~/.ssh/config), dùng sudo kubectl
K8S_SSH_HOST="192.168.1.100"           # IP, hostname hoặc Host alias trong ~/.ssh/config
K8S_SSH_USER="vbox"                    # SSH User (để trống "" nếu lấy từ ~/.ssh/config)
K8S_SSH_PORT="22"                      # Cổng SSH (để trống "" nếu lấy từ ~/.ssh/config)
K8S_SSH_KEY=""                         # Private key SSH (để trống nếu lấy từ ~/.ssh/config)
K8S_SSH_JUMP=""                        # Tùy chọn Jump Host (ProxyJump, ví dụ: user@bastion:22)
K8S_USE_SUDO="true"                    # Chạy 'sudo kubectl' (đã cấu hình NOPASSWD lên root)

# Cấu hình cụm K8s mặc định
K8S_NAMESPACE="default"
K8S_MODE="debug"                       # 'debug' (gắn Ephemeral debug container), 'sidecar', hoặc 'cp'
SIDECAR_IMAGE="docker.io/duyle95/profiling-sidecar:latest"
