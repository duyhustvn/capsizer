# ==============================================================================
# CẤU HÌNH KIỂM THỬ TẢI & PROFILING 2 PHA (KIẾN TRÚC 3 MÁY PHÂN TÁN)
# ==============================================================================
# Mô hình phân bổ:
#   [Machine 1] Máy chạy Skill  : Nơi bạn đang đứng (Antigravity Agent)
#   [Machine 2] Máy phát tải    : Máy bắn tải chuyên dụng qua SSH
#   [Machine 3] Server cụm K8s  : Master/Bastion node của cụm K8s qua SSH
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MACHINE 2: MÁY PHÁT TẢI (LOAD GENERATOR HOST QUA SSH)
# ------------------------------------------------------------------------------
LOADGEN_MODE="remote"                  # 'remote' (khuyên dùng) hoặc 'local'
REMOTE_HOST="192.168.1.50"             # IP máy phát tải
REMOTE_USER="vbox"                     # SSH User máy phát tải
REMOTE_PORT="22"                       # Cổng SSH máy phát tải
REMOTE_KEY=""                          # SSH private key (để trống nếu dùng ~/.ssh/id_rsa mặc định)
REMOTE_DIR="~/capsizer-loadtest"        # Thư mục làm việc trên máy phát tải

# ------------------------------------------------------------------------------
# 2. MACHINE 3: SERVER CỤM KUBERNETES TỪ XA (K8S MASTER / BASTION HOST QUA SSH)
# ------------------------------------------------------------------------------
# Skill sẽ SSH vào server này, dùng quyền root (sudo) để chạy kubectl chui vào Pod
K8S_SSH_HOST="192.168.1.100"           # IP Server cụm K8s / Master node
K8S_SSH_USER="vbox"                    # SSH User (đã cấu hình SSH key passwordless)
K8S_SSH_PORT="22"                      # Cổng SSH server K8s
K8S_SSH_KEY=""                         # Private key SSH (nếu dùng key riêng)
K8S_USE_SUDO="true"                    # Chạy 'sudo kubectl' (đã cấu hình NOPASSWD lên root)

# Thông tin Pod / Service mục tiêu trong K8s
K8S_NAMESPACE="default"
K8S_POD=""                             # Tên Pod mục tiêu (để trống nếu dùng selector bên dưới)
K8S_SELECTOR="app=chatbot"             # Tự động phát hiện Pod đang chạy theo nhãn này
K8S_CONTAINER=""                       # Container app trong Pod
K8S_MODE="debug"                       # 'debug' (gắn Ephemeral debug container), 'sidecar', hoặc 'cp'
TARGET_PORT="8000"                     # Cổng TCP của ứng dụng (để đo TCP Accept Queue)
SIDECAR_IMAGE="docker.io/duyle95/profiling-sidecar:latest"

# ------------------------------------------------------------------------------
# 3. THÔNG SỐ KỊCH BẢN KIỂM THỬ TẢI & PROFILING
# ------------------------------------------------------------------------------
TARGET_URL="http://10.0.0.10:8000/chat" # URL ứng dụng mục tiêu (máy phát tải phải kết nối được)
SCENARIO="chat-sse"                    # 'chat-sse', 'sample-get', 'sample-post'
METHOD="GET"
STEPS="2,4,8,16,32"                    # Dải bậc RPS cần đo
STEP_SECONDS="30"                      # Thời gian mỗi bậc (giây)
BASELINE_WAIT="60"                     # Thời gian chờ đo baseline CPU/RAM tĩnh (giây)
COOLDOWN="15"                          # Thời gian nghỉ giữa 2 bậc (giây)
SETTLE="60"                            # Thời gian chờ dọn dẹp request in-flight cuối bậc
TIMEOUT="120"                          # Read timeout mỗi request (giây)
MAX_INFLIGHT="2000"                    # Giới hạn in-flight đồng thời trên máy phát tải
CACHE_BUST="false"                     # Thêm tham số ngẫu nhiên chống cache
SKIP_VERIFY="false"                    # Bỏ qua xác thực TLS/SSL

# File dữ liệu kịch bản
QUERIES_FILE=""                        # Đường dẫn file câu hỏi (nếu có)
USERS_CSV=""                           # Đường dẫn file users.csv (nếu có)
BODY=""                                # Chuỗi body JSON (cho REST)
BODY_FILE=""                           # File body payload

# Loại profiler ở Pha 2 khi gặp điểm gãy (Knee Point)
PROFILE_TYPE="pyspy"                   # 'pyspy' (Python/FastAPI) hoặc 'perf' (Go/C++/Java)
