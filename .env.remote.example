# ==============================================================================
# CẤU HÌNH HẠ TẦNG KẾT NỐI 3 MÁY (CAPSIZER INFRASTRUCTURE CONFIG)
# ==============================================================================
# File này CHỈ chứa thông tin hạ tầng kết nối cố định của môi trường test.
# Các thông số riêng của từng kịch bản (URL, steps, queries, users, body, profiler...)
# được quản lý độc lập tại: scenarios/<tên_kịch_bản>/scenario.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MACHINE 2: MÁY PHÁT TẢI (LOAD GENERATOR HOST QUA SSH)
# ------------------------------------------------------------------------------
LOADGEN_MODE="remote"                  # 'remote' (khuyên dùng) hoặc 'local'
REMOTE_HOST="192.168.1.50"             # IP hoặc hostname máy phát tải
REMOTE_USER="vbox"                     # SSH User máy phát tải
REMOTE_PORT="22"                       # Cổng SSH máy phát tải
REMOTE_KEY=""                          # SSH private key (để trống nếu dùng ~/.ssh/id_rsa mặc định)
REMOTE_DIR="~/capsizer-loadtest"        # Thư mục làm việc trên máy phát tải

# ------------------------------------------------------------------------------
# 2. MACHINE 3: SERVER CỤM KUBERNETES TỪ XA (K8S MASTER / BASTION HOST QUA SSH)
# ------------------------------------------------------------------------------
# Skill sẽ SSH vào server này, dùng quyền root (sudo) để chạy kubectl chui vào Pod
K8S_SSH_HOST="192.168.1.100"           # IP Server cụm K8s / Master node
K8S_SSH_USER="vbox"                    # SSH User (đã cấu hình SSH key passwordless)
K8S_SSH_PORT="22"                      # Cổng SSH server K8s
K8S_SSH_KEY=""                         # Private key SSH (nếu dùng key riêng)
K8S_USE_SUDO="true"                    # Chạy 'sudo kubectl' (đã cấu hình NOPASSWD lên root)

# Cấu hình cụm K8s mặc định
K8S_NAMESPACE="default"
K8S_MODE="debug"                       # 'debug' (gắn Ephemeral debug container), 'sidecar', hoặc 'cp'
SIDECAR_IMAGE="docker.io/duyle95/profiling-sidecar:latest"
