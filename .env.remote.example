# ==============================================================================
# CẤU HÌNH KIỂM THỬ TẢI QUA MÁY PHÁT TẢI TỪ XA (CAPSIZER REMOTE)
# ==============================================================================

# 1. Thông tin kết nối SSH tới Máy Phát Tải (Load Generator Host)
REMOTE_HOST="192.168.1.50"
REMOTE_USER="vbox"
REMOTE_PORT="22"
REMOTE_KEY=""                          # Để trống nếu dùng ssh key mặc định (~/.ssh/id_rsa / agent)
REMOTE_DIR="~/capsizer-loadtest"        # Thư mục chứa runner và file log trên máy từ xa

# 2. Thông số kịch bản kiểm thử tải (ramps/golang)
TARGET_URL="http://10.0.0.10:8000/chat" # URL ứng dụng mục tiêu (máy từ xa phải kết nối được)
SCENARIO="chat-sse"                    # 'chat-sse', 'sample-get', 'sample-post'
STEPS="1,2,4,8,16"                     # Danh sách các bậc RPS (req/s)
STEP_SECONDS="60"                      # Thời gian phát tải ở mỗi bậc (giây)
COOLDOWN="20"                          # Thời gian nghỉ giải phóng tải giữa các bậc (giây)
SETTLE="60"                            # Thời gian chờ tối đa dọn dẹp request in-flight cuối bậc
TIMEOUT="120"                          # Read timeout cho mỗi request (giây)
MAX_INFLIGHT="2000"                    # Giới hạn in-flight đồng thời trên máy bắn tải
BASELINE_WAIT="90"                     # Chờ 90s đo baseline CPU tĩnh trước bậc 1 (0 để bỏ qua)
CACHE_BUST="false"                     # Thêm query param ngẫu nhiên để tránh proxy cache
STOP_ON_KNEE="false"                   # Dừng sớm nếu achieved < 90% offered

# Dữ liệu kịch bản
QUERIES_FILE=""                        # Đường dẫn file danh sách câu hỏi (bắt buộc với chat-sse)
USERS_CSV=""                           # Đường dẫn file users.csv (nếu có)
JWT_SECRET=""                          # Khóa ký token JWT (nếu cần sinh token tự động)
JWT_TOKEN=""                           # Token JWT cố định

# 3. Thông tin mục tiêu (để deploy và thu thập dữ liệu từ probe.go)
TARGET_TYPE="k8s"                      # "k8s" hoặc "ssh" (nếu target chạy trên VM)
K8S_NAMESPACE="default"
K8S_POD=""                             # Tên Pod mục tiêu (để trống nếu script tự phát hiện qua selector)
K8S_SELECTOR=""                        # Ví dụ: "app=chatbot"
TARGET_PORT="8000"                     # Cổng dịch vụ đang lắng nghe (để đo TCP Accept Queue)
