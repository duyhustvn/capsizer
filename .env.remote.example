# ==============================================================================
# CẤU HÌNH KIỂM THỬ TẢI & PROFILING 2 PHA (CAPSIZER 2-PHASE & REMOTE)
# ==============================================================================

# 1. Chế độ máy phát tải (local: chính máy này, remote: máy bắn tải qua SSH)
LOADGEN_MODE="remote"                  # 'local' hoặc 'remote'

# Thông tin kết nối SSH tới Máy Phát Tải (khi LOADGEN_MODE="remote")
REMOTE_HOST="192.168.1.50"
REMOTE_USER="vbox"
REMOTE_PORT="22"
REMOTE_KEY=""                          # Để trống nếu dùng ssh key mặc định (~/.ssh/id_rsa / agent)
REMOTE_DIR="~/capsizer-loadtest"        # Thư mục chứa runner và file log trên máy từ xa

# 2. Thông số kịch bản kiểm thử tải
TARGET_URL="http://10.0.0.10:8000/chat" # URL ứng dụng mục tiêu
SCENARIO="chat-sse"                    # 'chat-sse', 'sample-get', 'sample-post'
METHOD="GET"
STEPS="2,4,8,16,32"                    # Danh sách các bậc RPS (req/s)
STEP_SECONDS="30"                      # Thời gian phát tải ở mỗi bậc (giây)
BASELINE_WAIT="60"                     # Chờ 60s đo baseline CPU/RAM nền tĩnh trước bậc 1
COOLDOWN="15"                          # Thời gian nghỉ giải phóng tải giữa các bậc (giây)
SETTLE="60"                            # Thời gian chờ tối đa dọn dẹp request in-flight cuối bậc
TIMEOUT="120"                          # Read timeout cho mỗi request (giây)
MAX_INFLIGHT="2000"                    # Giới hạn in-flight đồng thời trên máy bắn tải
CACHE_BUST="false"                     # Thêm tham số ngẫu nhiên chống cache
SKIP_VERIFY="false"                    # Bỏ qua xác thực TLS/SSL

# File dữ liệu kịch bản
QUERIES_FILE=""                        # Đường dẫn file câu hỏi (nếu có)
USERS_CSV=""                           # Đường dẫn file users.csv (nếu có)
BODY=""                                # Chuỗi body (cho REST)
BODY_FILE=""                           # File body payload

# 3. Thông số Profiling & Ứng dụng Mục Tiêu (Target)
PROFILE_TYPE="pyspy"                   # 'pyspy' (Python/FastAPI) hoặc 'perf' (Go/C++/Java)
K8S_POD=""                             # Tên Pod mục tiêu trên K8s (để trống nếu test local/external)
K8S_NAMESPACE="default"
K8S_CONTAINER=""                       # Container app trong Pod
K8S_MODE="debug"                       # 'debug' (khuyên dùng - gắn Ephemeral container), 'sidecar', hoặc 'cp'
TARGET_PORT="8000"                     # Cổng dịch vụ đang lắng nghe (để đo TCP Accept Queue)
