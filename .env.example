# ==============================================================================
# CẤU HÌNH CAPSIZER (.env)
# ==============================================================================

# Khóa bí mật ký JWT HS256 (tùy chọn: sinh Bearer token tự động với role super_admin)
JWT_SECRET=your-jwt-secret-key

# Danh sách câu hỏi kiểm thử cho kịch bản Chatbot SSE (chat-sse)
# Các định dạng được hỗ trợ:
#
# Cách 1: Phân tách bởi ký tự pipe | (Khuyên dùng - dễ đọc và chỉnh sửa trên 1 dòng):
# CHAT_QUERIES="Xin chào, bạn có thể hỗ trợ những tác vụ gì?|Hãy tóm tắt ngắn gọn các điểm chính của tài liệu này|Hướng dẫn tôi cách tích hợp API vào hệ thống|Giải thích giúp tôi nguyên lý hoạt động của kiến trúc microservices|Gợi ý cho tôi một số giải pháp tối ưu hóa hiệu năng|Chào bạn"

# Cách 2: Phân tách bởi ký tự xuống dòng:
# CHAT_QUERIES="Câu hỏi 1
# Câu hỏi 2
# Câu hỏi 3"

# Cách 3: Định dạng JSON array:
# CHAT_QUERIES='["Câu hỏi 1", "Câu hỏi 2", "Câu hỏi 3"]'

# Cách 4: Đường dẫn đến file chứa danh sách câu hỏi (mỗi dòng một câu):
CHAT_QUERIES_FILE=queries.txt
