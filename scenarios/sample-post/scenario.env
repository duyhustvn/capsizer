# ==============================================================================
# CẤU HÌNH KỊCH BẢN REST API POST (SAMPLE-POST)
# ==============================================================================
SCENARIO="sample-post"
TARGET_URL="https://jsonplaceholder.typicode.com/posts"
TARGET_PORT="443"
PROFILE_TYPE="perf"                  # Ứng dụng Golang/NodeJS/Java dùng perf

# Thông số phát tải
STEPS="5,10,20,50"
STEP_SECONDS="15"
BASELINE_WAIT="0"
COOLDOWN="5"

METHOD="POST"
BODY_FILE="payload.json"
