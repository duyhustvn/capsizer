{
  "name": "chat-sse",
  "type": "sse",
  "url": "http://10.0.0.10:8000/chat",
  "method": "POST",
  "headers": {
    "Content-Type": "application/json",
    "Authorization": "Bearer {{.users.token}}"
  },
  "body": "{\"prompt\": {{quote .prompts}}, \"stream\": true}",
  "datasets": {
    "prompts": {
      "file": "queries.txt",
      "mode": "random"
    },
    "users": {
      "file": "users.csv",
      "mode": "sequential"
    }
  },
  "expected_status": [200],
  "sse": {
    "end_marker": "[DONE]"
  }
}
