# ==============================================================================
# CẤU HÌNH KỊCH BẢN CHATBOT STREAMING SSE (CHAT-SSE)
# ==============================================================================
SCENARIO="chat-sse"
TARGET_URL="http://10.0.0.10:8000/chat"
TARGET_PORT="8000"
K8S_SELECTOR="app=chatbot"
PROFILE_TYPE="pyspy"                 # Ứng dụng Python/FastAPI dùng py-spy lấy stack trace

# Thông số phát tải định chuẩn
STEPS="2,4,8,16,32"
STEP_SECONDS="30"
BASELINE_WAIT="60"
COOLDOWN="15"
TIMEOUT="120"
MAX_INFLIGHT="2000"

# Tệp dữ liệu kịch bản (đường dẫn tương đối trong thư mục kịch bản này)
QUERIES_FILE="queries.txt"
USERS_FILE="users.csv"
CACHE_BUST="true"
