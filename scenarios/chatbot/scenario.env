# ==============================================================================
# CẤU HÌNH THỰC THI & HẠ TẦNG CHO KỊCH BẢN CHATBOT (CHAT-SSE)
# (Chi tiết request/headers/body/queries/users đã khai báo trong scenario.json)
# ==============================================================================
K8S_SELECTOR="app=chatbot"
PROFILE_TYPE="pyspy"                 # 'pyspy', 'perf', 'pyspy,perf' hoặc 'all'

# TARGET_PORT: Tùy chọn (mặc định tự bóc tách từ URL trong scenario.json).
# Chỉ khai báo khi cổng nội bộ Pod khác với cổng của Ingress/URL bên ngoài.
# TARGET_PORT="8000"

# Thông số bậc tải định chuẩn
STEPS="2,4,8,16,32"
STEP_SECONDS="30"
BASELINE_WAIT="60"
COOLDOWN="15"
TIMEOUT="120"
MAX_INFLIGHT="2000"
CACHE_BUST="true"
